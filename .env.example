# =============================================================================
# Vulnalyze Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (only needed if NOT using SQLite local mode) ---
POSTGRES_USER=vulnalyze
POSTGRES_PASSWORD=vulnalyze_secret
POSTGRES_DB=vulnalyze

# --- JWT Secret ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey_change_in_production_12345

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 OpenRouter API Key — WHERE TO PASTE YOUR KEY
# ─────────────────────────────────────────────────────────────────────────────
# Get a FREE key at: https://openrouter.ai (sign up → API Keys → Create Key)
# Paste your key below (starts with "sk-or-..."):
#
#   OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# What this enables:
#   - LangChain AI Security Agent (Claude Haiku via OpenRouter)
#   - POST /api/v1/scans/{id}/ai-analyze — structured remediation advice
#   - POST /api/analyze, /api/fix, /api/explain — AI code assistant
#
# Without this key: rule-based remediation still works, just no LLM.
OPENROUTER_API_KEY=

# --- Frontend URL (CORS whitelist for backend) ---
FRONTEND_URL=http://localhost:5173

# --- Frontend API target (set this in frontend/.env.local) ---
VITE_API_BASE_URL=http://localhost:8000
