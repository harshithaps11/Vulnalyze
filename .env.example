# =============================================================================
# Vulnalyze Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=vulnalyze
POSTGRES_PASSWORD=vulnalyze_secret
POSTGRES_DB=vulnalyze

# --- JWT Secret ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey_change_in_production_12345

# --- OpenRouter AI (optional — used for AI-powered remediation) ---
# Get your key at: https://openrouter.ai
OPENROUTER_API_KEY=

# --- Frontend (if running without Docker) ---
# Used in frontend/.env or frontend/.env.local
VITE_API_BASE_URL=http://localhost:8000
