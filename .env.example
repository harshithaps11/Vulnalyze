# =============================================================================
# Vulnalyze Environment Variables — EXAMPLE FILE
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=vulnalyze
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=vulnalyze
POSTGRES_SERVER=localhost

# --- JWT Secret ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_strong_secret_here

# --- AI / LLM (optional) ---
# Get a FREE key at: https://openrouter.ai
# Without this, rule-based remediation still works perfectly.
OPENROUTER_API_KEY=

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Frontend API target ---
VITE_API_BASE_URL=http://localhost:8000

# --- OWASP ZAP (optional — HTTP header scan is the fallback) ---
# When using Docker Compose, set ZAP_HOST=zap
ZAP_HOST=localhost
ZAP_PORT=8080
ZAP_API_KEY=

# --- Redis (optional — graceful no-op when not set) ---
# When using Docker Compose, set REDIS_HOST=redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Container Scanner (optional) ---
# Set to path of 'trivy' binary if installed
# TRIVY_PATH=trivy

# --- Network Scanner (optional) ---
# Set to path of 'nmap' binary if installed
# NMAP_PATH=nmap
